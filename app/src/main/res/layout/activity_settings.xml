<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9F4">

  <!-- Header -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#26352A" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Manage your Smart Pantry preferences."
        android:textSize="14sp"
        android:textColor="#68736B" />

  </LinearLayout>

  <!-- Settings Content -->
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

      <!-- Expiry Alert Setting -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:padding="16dp"
          android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Expiry Alerts"
              android:textSize="18sp"
              android:textStyle="bold"
              android:textColor="#26352A" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:text="Enable alerts for ingredients approaching their expiry date."
              android:textSize="14sp"
              android:textColor="#68736B" />

        </LinearLayout>

        <Switch
            android:id="@+id/switchExpiryAlerts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />

      </LinearLayout>

      <!-- Units Preference -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="24dp"
          android:text="Preferred Unit"
          android:textSize="18sp"
          android:textStyle="bold"
          android:textColor="#26352A" />

      <Spinner
          android:id="@+id/spinnerUnits"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:entries="@array/unit_options" />

      <TextView
          android:id="@+id/txtSettingsMessage"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="24dp"
          android:text=""
          android:textSize="14sp"
          android:textColor="#68736B" />

    </LinearLayout>

  </ScrollView>

  <!-- Bottom Navigation -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:padding="8dp"
      android:background="#FFFFFF">

    <Button
        android:id="@+id/btnPantry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Pantry"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnRecipes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Recipes"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Settings"
        android:textAllCaps="false" />

  </LinearLayout>

</LinearLayout>