<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Ingredient"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#26352A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Add an ingredient currently available in your pantry."
            android:textSize="14sp"
            android:textColor="#68736B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Ingredient Name"
            android:textStyle="bold"
            android:textColor="#26352A" />

        <EditText
            android:id="@+id/editIngredientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Tomatoes"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Quantity"
            android:textStyle="bold"
            android:textColor="#26352A" />

        <EditText
            android:id="@+id/editIngredientQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 2"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Unit"
            android:textStyle="bold"
            android:textColor="#26352A" />

        <EditText
            android:id="@+id/editIngredientUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. pieces, kg, g, litres"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Expiry Date (Optional)"
            android:textStyle="bold"
            android:textColor="#26352A" />

        <EditText
            android:id="@+id/editIngredientExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select expiry date"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false" />

        <Button
            android:id="@+id/btnSaveIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Save Ingredient"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnCancelIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cancel"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>